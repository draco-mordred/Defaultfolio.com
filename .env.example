UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Blog community features require the Upstash Redis instance above.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
BLOG_IDENTITY_SECRET=

# Cloudflare Turnstile keys. Use your public site key in NEXT_PUBLIC_TURNSTILE_SITE_KEY.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Long random token used to access /blog/moderation.
BLOG_MODERATOR_TOKEN=
